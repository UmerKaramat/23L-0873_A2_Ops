# ==============================================================================
# VisionGuard: Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual DagsHub credentials.
# Do NOT commit your actual .env file to Git!
# ==============================================================================

# DagsHub MLflow Remote Tracking
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_USERNAME>/VisionGuard.mlflow
MLFLOW_TRACKING_USERNAME=<DAGSHUB_USERNAME>
MLFLOW_TRACKING_PASSWORD=<DAGSHUB_TOKEN>

# Optional DagsHub / DVC Settings
DAGSHUB_USER_TOKEN=<DAGSHUB_TOKEN>

